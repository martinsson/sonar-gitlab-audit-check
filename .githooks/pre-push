#!/usr/bin/env bash
# Runs the fast gates (./verify) before anything leaves the machine. Docker integration tests and
# mutation testing stay in CI. Skip once with `git push --no-verify`: CI still runs everything.
cd "$(git rev-parse --show-toplevel)" || exit 1

# Deleting a remote branch pushes nothing to check.
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [[ "$local_sha" =~ ^0+$ ]] || pushing=1
done
[ "$pushing" -eq 0 ] && exit 0

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: uncommitted changes are checked too, but they are not part of this push" >&2
fi
exec ./verify
