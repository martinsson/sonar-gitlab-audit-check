# Copy to .env (git-ignored) and fill in. Never commit .env.
#
# ENCRYPTION_SECRET encrypts the connection tokens DevLake stores. Generate it once and keep it:
# losing it makes the stored connections unreadable.
#   openssl rand -base64 2000 | tr -dc 'A-Z' | fold -w 128 | head -n 1
ENCRYPTION_SECRET=

MYSQL_ROOT_PASSWORD=
MYSQL_USER=merico
MYSQL_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Host ports, all bound to 127.0.0.1.
UI_PORT=4000
DEVLAKE_PORT=8080
MYSQL_PORT=3306
