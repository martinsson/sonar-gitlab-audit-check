<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Structural limits. Formatting is Spotless' job, so no whitespace/indent rules here.
  Every limit below is a deliberate, tunable architectural guardrail.
-->
<module name="Checker">
  <property name="severity" value="error"/>

  <!-- No classes bigger than 800 lines -->
  <module name="FileLength">
    <property name="max" value="800"/>
  </module>

  <module name="TreeWalker">
    <!-- No methods longer than 50 lines -->
    <module name="MethodLength">
      <property name="max" value="50"/>
    </module>
    <!-- More than 5 parameters: introduce a parameter object -->
    <module name="ParameterNumber">
      <property name="max" value="5"/>
      <property name="ignoreOverriddenMethods" value="true"/>
    </module>
    <module name="RecordComponentNumber">
      <property name="max" value="8"/>
    </module>

    <!-- Size measured in statements, not lines, so formatting cannot game it -->
    <module name="JavaNCSS">
      <property name="methodMaximum" value="30"/>
      <property name="classMaximum" value="300"/>
      <property name="fileMaximum" value="400"/>
    </module>
    <module name="MethodCount">
      <property name="maxTotal" value="30"/>
      <property name="maxPublic" value="20"/>
    </module>
    <module name="OuterTypeNumber">
      <property name="max" value="1"/>
    </module>
    <module name="AnonInnerLength">
      <property name="max" value="20"/>
    </module>
    <module name="LambdaBodyLength">
      <property name="max" value="10"/>
    </module>

    <!-- Coupling: how many other classes one class knows about -->
    <module name="ClassFanOutComplexity">
      <property name="max" value="20"/>
    </module>
    <module name="ClassDataAbstractionCoupling">
      <property name="max" value="7"/>
    </module>

    <module name="CyclomaticComplexity">
      <property name="max" value="10"/>
    </module>
    <module name="NPathComplexity">
      <property name="max" value="200"/>
    </module>
    <module name="BooleanExpressionComplexity">
      <property name="max" value="3"/>
    </module>
    <module name="NestedIfDepth">
      <property name="max" value="2"/>
    </module>
    <module name="NestedForDepth">
      <property name="max" value="2"/>
    </module>
    <module name="NestedTryDepth">
      <property name="max" value="1"/>
    </module>

    <!-- Banned imports (second line of defence behind maven-enforcer and ArchUnit) -->
    <module name="IllegalImport">
      <property name="illegalPkgs" value="org.mockito, sun, com.sun"/>
    </module>

    <module name="AvoidStarImport"/>
    <module name="UnusedImports"/>
    <module name="EmptyCatchBlock"/>
    <module name="MissingSwitchDefault"/>
    <module name="FallThrough"/>
  </module>
</module>
